{
  "name": "boda-berta-edu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web de la boda de Berta i Edu (15.05.2027, Menorca) con RSVP en Supabase",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
