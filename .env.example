# Copiad este archivo a .env.local SOLO para pruebas en vuestro ordenador.
# En producción, estos valores se ponen en Vercel → Project → Settings → Environment Variables.
# Nunca subáis los valores reales a Git ni los peguéis en ningún chat.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → clave secreta (service_role o sb_secret_...)
# Solo la usa el servidor. NUNCA debe aparecer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=pon-aqui-la-clave-secreta

# Cadena aleatoria larga para anonimizar IPs al limitar envíos abusivos (p. ej. `openssl rand -hex 32`)
RSVP_HASH_SALT=pon-aqui-una-cadena-aleatoria

# Opcional: dominios desde los que se acepta el formulario, separados por comas
# ALLOWED_ORIGINS=https://bertaiedu.com,https://www.bertaiedu.com

# Cadena aleatoria larga. Vercel la usa para llamar a /api/keepalive una vez al día
# y evitar que Supabase pause el proyecto gratuito por inactividad.
CRON_SECRET=pon-aqui-otra-cadena-aleatoria
